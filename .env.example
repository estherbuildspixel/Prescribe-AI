DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prescribe_ai?schema=public"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.1-flash-lite"
# Comma-separated models to try if the main model is overloaded or slow
GEMINI_FALLBACK_MODEL="gemini-3.5-flash,gemini-3.6-flash"
# Max time (ms) to wait for the model to start before trying a fallback
GEMINI_STARTUP_BUDGET_MS="1800"
